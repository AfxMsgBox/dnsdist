[Unit]
Description=Update dnsdist advertisement and proxy-domain rules
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-@INSTALL_DIR@/config/dnsdist-automation
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@INSTALL_DIR@/sh/update-dnsdist-domains.py
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@INSTALL_DIR@/generated
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
